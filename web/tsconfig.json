{
  "include": ["app/**/*", "*.ts", ".react-router/types/**/*", "swift/.build/plugins/PackageToJS/outputs/Package/**/*.d.ts"],
  "exclude": ["node_modules", "build", "swift/.build/checkouts", "swift/.build/repositories"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "~/*": ["./app/*"] },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
